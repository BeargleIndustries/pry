{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pry",
  "version": "0.4.0",
  "identifier": "com.beargle.pry",
  "app": {
    "windows": [
      {
        "title": "Pry",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost http://tauri.localhost; connect-src 'self' ipc: http://ipc.localhost http://tauri.localhost http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: blob: http://tauri.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "devCsp": "default-src 'self' ipc: http://ipc.localhost http://tauri.localhost; connect-src 'self' ipc: http://ipc.localhost http://tauri.localhost http://127.0.0.1:* ws://127.0.0.1:* http://localhost:5173 ws://localhost:5173 http://localhost:1420; img-src 'self' data: blob: http://tauri.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'"
    }
  },
  "build": {
    "frontendDist": "../ui/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix ./ui",
    "beforeBuildCommand": "npm run build --prefix ./ui"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Pry open the black box",
    "longDescription": "Local-first desktop interpretability tool for small transformer LLMs.",
    "copyright": "© 2026 Beargle Industries",
    "publisher": "Beargle Industries",
    "homepage": "https://beargleindustries.com",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../sidecar/pyproject.toml",
      "../sidecar/presets.json",
      "../sidecar/pry_sidecar/*.py",
      "../ui/build-cli/lessons-lint.mjs",
      "../docs/lessons/AUTHORING.md"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "timestampUrl": null,
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "languages": ["English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwNkRERkY5MzMxNDVBRDgKUldUWVdoUXorZDl0c0ViVlJVTEQxUEpCT3RhZ3c2MGhsMEoyRjVUUklXSDlnMmZiWGYwUXlycGYK",
      "endpoints": [
        "https://github.com/BeargleIndustries/pry/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
