{
  "name": "pry-ui",
  "version": "0.3.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5173",
    "build": "vite build && npm run build:cli",
    "build:cli": "vite build -c vite.cli.config.ts",
    "lessons:lint": "vite-node -c vite.cli.config.ts scripts/lessons-lint.ts",
    "lessons:compile": "vite-node -c vite.cli.config.ts scripts/lessons-compile.ts",
    "lessons:schema": "vite-node -c vite.cli.config.ts scripts/lessons-schema.ts",
    "lessons:rows": "vite-node -c vite.cli.config.ts scripts/outline-rows.ts",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check .",
    "test": "svelte-kit sync && vitest run",
    "prepare": "svelte-kit sync || echo \"\""
  },
  "dependencies": {
    "@tauri-apps/plugin-process": "~2.3.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "~2.10.0",
    "d3-interpolate": "^3",
    "d3-scale": "^4",
    "lucide-svelte": "^0.460",
    "remark-directive": "^3.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3",
    "@sveltejs/kit": "^2",
    "@sveltejs/vite-plugin-svelte": "^4",
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@types/d3-interpolate": "^3",
    "@types/d3-scale": "^4",
    "@types/node": "^22.20.5",
    "autoprefixer": "^10",
    "postcss": "^8",
    "prettier": "^3.4",
    "prettier-plugin-svelte": "^3.2",
    "svelte": "^5",
    "svelte-check": "^4",
    "tailwindcss": "^3.4",
    "tslib": "^2.8",
    "typescript": "^5.6",
    "vite": "^5.4",
    "vitest": "^2.1.9"
  }
}
